<h2>Add a coffee place</h2>

<article>
  <%= form_with model: @coffee_place, url: coffee_places_path do |form| %>
    <% if @coffee_place.errors.any? %>
      <ul class="error-messages">
        <% @coffee_place.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form.label :name %>
    <%= form.text_field :name %>

    <%= form.label :address %>
    <%= form.text_field :address %>

    <%= form.label :rating %>
    <%= form.select :rating, (1..5), include_blank: true %>

    <% selected = @coffee_place.favorite_drink ? "#{@coffee_place.favorite_drink_type}-#{@coffee_place.favorite_drink_id}" : "" %>
    <%= form.label :favorite_drink, "Favorite drink" %>
    <%= form.select :favorite_drink,
          grouped_options_for_select(
            {
              "Coffee" => Coffee.order(:name).pluck(:name, :id).map { |name, id| [name, "Coffee-#{id}"] },
              "Tea" => Tea.order(:name).pluck(:name, :id).map { |name, id| [name, "Tea-#{id}"] }
            },
            selected
          ),
          include_blank: true %>

    <%= form.submit "Add place" %>
  <% end %>
</article>

<%= link_to "Back to list", coffee_places_path %>
